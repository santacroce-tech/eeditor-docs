;; EEditor keybindings — this file *is* the shortcut table. Edit it and save (⌘S): it reloads
;; immediately. Delete it and EEditor falls back to these defaults.
;;
;;   (bind "Key" body…)
;;
;; Key: modifiers joined with "-" or "+", then the key. Mod = ⌘ on macOS, Ctrl elsewhere;
;; Cmd, Ctrl, Alt (Option) and Shift can also be named directly.  e.g. "Mod-i", "Mod-Shift-f",
;; "Ctrl-Alt-t". Every binding needs a modifier (function keys and Escape may go bare).
;;
;; The body is EELisp, evaluated on the engine when the key fires. It returns editor commands:
;;
;;   (ed-cmd "save")                 run a built-in command (list at the bottom)
;;   (ed-insert text)                insert at the cursor, caret after the text
;;   (ed-insert-at pos text)
;;   (ed-goto pos)                   caret to an absolute offset
;;   (ed-goto-line n)                caret to the start of line n (1-based)
;;   (ed-select from to)
;;   (ed-replace text)               replace the selection
;;   (ed-replace-range from to text)
;;   (ed-set-buffer text)            replace the whole document
;;   (ed-open "notes/x.md")          open a file in a tab
;;   (ed-new path)                   create the note if it doesn't exist, then open it
;;   (ed-new path text)              …with text as its starting content
;;   (ed-form "Contacts")            open a .eeform and run it, in a window beside your notes
;;   (ed-message text)               toast
;;   (ed-notify title body)          toast, and a system notification when EEditor isn't in front
;;   (ed-prompt "When?" my-fn)       ask; then (my-fn answer) runs like a key. Optional default and
;;                                   choices: (ed-prompt "Tag?" my-fn "" (list "work" "home"))
;;   (ed-append "inbox.md" text)     add to the end of a note, open or not — created if missing
;;   (ed-append path text "## Log")  …at the end of that section (added if it isn't there)
;;   (ed-write path text)            replace a note's text; (ed-write path text old) only if it
;;                                   still says old — so a note being typed into is left alone
;;
;; Reading other notes: (notes) lists every .md in the workspace, (notes "reviews") those in a
;; folder; (read-note "inbox.md") is one's text as saved (nil if there's none). Unsaved tabs are
;; saved before any binding runs, so what you read is what's on screen.
;;
;; A binding may list several commands; they run in order against the live document.
;; Anything the standard bundle (the REPL's "snippets" button) defines is callable here too.
;;
;; (on-start body…) runs the same kind of commands once, when EEditor has loaded the workspace —
;; it decides which note you land on. Without it, EEditor opens welcome.md while that's still
;; around, and today's note after that. See the bottom of this file.
;;
;; (on-load body…) is for definitions — your own functions, tables, a library like the PIM's. It
;; runs at launch before on-start, and again every time this file is saved, so an edit to a
;; helper takes effect on ⌘S. Its value is ignored: it's not for commands.
;;
;; (on-tick body…) runs once a minute, on the minute, with the same context as a key, and its
;; commands are carried out — (ed-notify …) for a reminder, say. Keep it quick.
;;
;; There may be several on-load and on-tick forms; each runs, in order.
;;
;; Context, defined fresh before every run:
;;   *file*        path of the current note        *cursor*   caret offset
;;   *line*        caret line (1-based)            *col*      caret column (1-based)
;;   *line-text*   text of the caret's line        *lines*    line count
;;   *line-from*  *line-to*   where the caret's line starts and ends — offsets for ed-replace-range
;;   *sel-from*  *sel-to*                          *selection*  the selected text
;;   *buffer*      the whole document
;;   *date* "YYYY-MM-DD"   *time* "HH:MM"   *now* "YYYY-MM-DD HH:MM:SS"   (local time)
;;
;; (*selection* and *buffer* are only computed when the binding mentions them.)

;; ── app commands ───────────────────────────────────────────────────────────
(bind "Mod-s"       (ed-cmd "save"))
(bind "Mod-p"       (ed-cmd "quick-open"))
(bind "Mod-Shift-f" (ed-cmd "search"))
(bind "Mod-d"       (ed-cmd "daily-note"))
(bind "Mod-Shift-n" (ed-cmd "new-file"))
(bind "Mod-j"       (ed-cmd "toggle-repl"))
(bind "Mod-e"       (ed-cmd "toggle-preview"))
(bind "Mod-Shift-k" (ed-cmd "open-keys"))

;; ── lisp ───────────────────────────────────────────────────────────────────

;; ⌘I — a new note stamped with the minute, e.g. "2026-08-09 1430.md", with the same stamp as
;; its heading. Press it twice in the same minute and you land back in the same note.
;; (No ":" in the name — Finder shows a colon as a "/".)
(bind "Mod-i"
  (ed-new (str *date* " " (str-replace *time* ":" "") ".md")
          (str "# " *date* " " *time* "\n\n")))

;; ⌘⇧I — a timestamped "## " heading at the caret, caret on the blank line under it.
(bind "Mod-Shift-i"
  (ed-insert (str (cond (= *col* 1) "" true "\n") "## " *time* "\n\n")))

;; A few more ideas — uncomment to enable:
;;
;; ⌘⌥I — the same heading, but at the top of the note (line 2)
;; (bind "Mod-Alt-i" (ed-goto-line 2) (ed-insert (str "## " *date* " " *time* "\n\n")))
;;
;; ⌘B — wrap the selection in bold
;; (bind "Mod-b" (ed-replace (str "**" *selection* "**")))
;;
;; ⌘⇧T — a "- [ ] " task line
;; (bind "Mod-Shift-t" (ed-insert "- [ ] "))
;;
;; ⌘⌥D — the day of the week, spelled out
;; (bind "Mod-Alt-d" (ed-insert (date-format *date* "EEEE")))
;;
;; ⌘⇧B — link back to today's note
;; (bind "Mod-Shift-b" (ed-insert (str "[[" *date* "]]")))

;; ── what opens at launch ───────────────────────────────────────────────────
;; Uncomment one. With every (on-start …) commented out, EEditor falls back to welcome.md — or,
;; once that's gone, to today's note, creating it if it isn't there yet.
;;
;; (on-start (ed-open "todo.md"))              ;; always this note
;; (on-start (ed-cmd "daily-note"))            ;; today's note, created if needed
;; (on-start (ed-new (str *date* ".md")))      ;; the same, spelled out
;; (on-start)                                  ;; nothing — start on an empty editor
;;
;; *date*, *time* and *now* are set here as well; the rest of the context describes the caret,
;; which at launch has no note to point at yet (*file* is "").

;; ── built-in commands ──────────────────────────────────────────────────────
;; save · quick-open · search · daily-note · new-file · new-sheet · new-form · new-mindmap · new-folder
;; open-keys
;; open-functions      your own spreadsheet functions (.eeditor/functions.eelisp), created if needed
;; reload-functions    load them again (saving the file does this too)
;; reload-keys · toggle-repl · focus-repl · toggle-preview · toggle-theme · export-pdf · snippets
;; theme-dark · theme-light · theme-vb6   pick a theme (toggle-theme walks all three)
;; calendar · agenda-setup · agenda-refresh · close-tab · next-tab · prev-tab · focus-editor
;; form-design · form-code · form-run   the active form tab's mode
;; mindmap-map · mindmap-text          the active mind map tab: the map, or its markdown outline
;; open-file           pick a file from anywhere; asks whether to copy it in or edit it in place
;; copy-into-workspace turn the current ↗ (outside) note into a copy in the workspace
;; add-samples         add the sample notes and the PIM tour to this folder (keeps what is there)
;; about               who makes EEditor, and which version this is
;; insert-image        pick images; each is copied into assets/ beside the note and linked at the caret

;; ══ Zero to Hero — chapter 2. Your first shortcut ══════════════════════════════

(on-load
  (defn open-tasks (path)
    (length (filter (fn (line) (str-starts-with line "- [ ]"))
                    (str-split (read-note path) "\n"))))

  ;; meetings/2026-10-26 Budget review.md
  (defn meeting-path (title) (str "meetings/" *date* " " title ".md"))

  (defn meeting-template (title)
    (str "# " title "\n\n" *date* " " *time* "\n\n"
         "## Who\n\n- \n\n## Notes\n\n\n## Decisions\n\n- \n\n## Actions\n\n- [ ] \n"))

  ;; what the meeting key calls with your answer
  (defn new-meeting (title) (ed-new (meeting-path title) (meeting-template title)))

  ;; "call the bank" → "- [ ] call the bank"; a line that is a task already stays one
  (defn as-task (line)
    (let (text (str-trim line))
      (cond (str-starts-with text "- [") text
            (str-starts-with text "- ")  (str "- [ ] " (substr text 2 (str-len text)))
            true                        (str "- [ ] " text)))))

(bind "Mod-Shift-m" (ed-prompt "Meeting about?" new-meeting))

(bind "Mod-Shift-a"
  (ed-append "inbox.md" (str (as-task *line-text*) "\n") "## Inbox")
  (ed-message "Sent to the inbox"))

;; ══ Zero to Hero — chapter 3. The agenda ══════════════════════════════

(on-load
  ;; "- [ ] pay the gas bill tomorrow !!" → the words, without the list marker
  (defn line-words (line)
    (let (t (str-trim line))
      (cond (str-starts-with t "- [ ] ") (substr t 6 (str-len t))
            (str-starts-with t "- ")     (substr t 2 (str-len t))
            true                        t)))

  (defn agenda-this (line)
    (let (d (item->dict (add (line-words line))))
      (ed-message (str "On the agenda"
                       (if (nil? (dict-get d :when)) "" (str " for " (dict-get d :when)))
                       ": " (dict-get d :text))))))

;; ⌘⇧G — get this line on the agenda
(bind "Mod-Shift-g" (agenda-this *line-text*))

;; ══ Zero to Hero — chapter 4. Rules that file for you ══════════════════════════════

(on-load
  (defcategory money/bills)
  (defcategory money/savings)
  (defcategory money/insurance)
  (defcategory home)
  (defcategory health)
  (defrule bills    :when (str-matches text "(?i)invoice|bill|rent") :assign "money/bills")
  (defrule savings  :when (str-matches text "(?i)bank|savings")      :assign "money/savings")
  (defrule doctors  :when (str-matches text "(?i)dentist|doctor|pharmacy") :assign "health")
  (defview money    :filter (has-category "money") :sort-by when)
  (defview late     :filter (overdue?) :sort-by when)
  (defview urgent   :filter (= priority "1") :sort-by when)
  (auto-categorize true))

;; ══ Zero to Hero — chapter 5. Notes kept in step ══════════════════════════════

;; ═══ EEditor PIM — org-mode habits in EELisp ════════════════════════════════════════════════
;;
;; Append this to .eeditor/keybindings.eelisp (⌘⇧K opens it). It replaces any (on-start …) you
;; already have; keep your own (bind …) and (on-load …) forms. Guide: docs/PIM.md.
;;
;; The (on-load …) body is the library. It runs at launch and again every time the file is saved,
;; so an edit to it takes effect on ⌘S. (on-start …) only picks what opens at launch; (on-tick …)
;; runs once a minute — reminders, and ticking lines whose items you finished elsewhere.
;;
;; Tasks are the built-in agenda's items: what you tick in a note is ticked in the agenda panel,
;; the calendar shows it, your rules file it, recurrence rolls it forward. The notes are the view
;; you write in; the agenda is where the tasks live.
;;
;; Everything is stored in the workspace database (.eeditor/eeditor.db), the one the agenda panel,
;; the REPL and forms already use. Don't call open-agenda here: it swaps out that whole database.

(on-load
  ;; ── settings ───────────────────────────────────────────────────────────────
  ;; Where capture files each kind of line: a note ("today" is today's daily note) and a heading.
  (def pim-capture-to (dict :task (list "today" "## Tasks")
                            :inbox (list "inbox.md" "## Inbox")
                            :log (list "today" "## Log")))
  ;; Notes, or folders, whose hand-typed "- [ ]" lines ⌘⌥S makes agenda items — org's agenda files.
  ;; (Lines with a {#id} are kept in step everywhere.) e.g. (list "projects" "inbox.md")
  (def pim-agenda-files (list))
  ;; Once a minute, tick the lines (in every note) whose items were finished in the agenda.
  (def pim-sweep-every-minute true)
  ;; How long after its time a reminder still fires — say EEditor was closed at 15:00.
  (def pim-remind-grace 60)

  ;; ── tables ─────────────────────────────────────────────────────────────────
  ;; clock: time spent on a task (org's CLOCK lines). A running clock has stop = 0.
  ;; `item` is the agenda item the task line links to, or 0.
  (deftable clock ((task  :type string) (item :type number) (file :type string) (day :type string)
                   (start :type number) (stop :type number) (mins :type number)))
  ;; done: every task you finish (org's CLOSED stamp + logbook). item-done forgets the item, so
  ;; this table is what the weekly review reads.
  (deftable done  ((at :type string) (day :type string) (task :type string) (item :type number)
                   (file :type string)))

  ;; ── the agenda's own furniture ─────────────────────────────────────────────
  ;; An inbox category for capture, and two saved views — (show pim-overdue) at the REPL, and in
  ;; the Views tab of examples/Agenda.eeform.
  (eval (parse "(defcategory inbox)"))
  (defview pim-overdue :filter (overdue?) :sort-by when)
  (defview pim-inbox :filter (has-category "inbox") :sort-by when)
  ;; log: the life tracker. A thing, an amount, at a time.
  (deftable log   ((at :type string) (day :type string) (kind :type string) (item :type string)
                   (qty :type number) (unit :type string) (note :type string)))
  ;; reminded: the reminders already shown, so each fires once.
  (deftable reminded ((item :type number) (day :type string) (at :type string)))

  ;; ── text ───────────────────────────────────────────────────────────────────
  ;; The caret's line, rewritten. *line-from* / *line-to* are offsets as the editor counts them, so
  ;; an emoji on the line is no trouble.
  (defn pim-set-line (text) (ed-replace-range *line-from* *line-to* text))

  (defn pim-indent (s)
    (loop (i 0)
      (let (c (substr s i (+ i 1)))
        (cond (or (= c " ") (= c "\t")) (recur (inc i))
              true (substr s 0 i)))))
  (defn pim-rest-after (s sep)   ;; everything after the first sep, or nil
    (let (parts (str-split s sep))
      (cond (> (length parts) 1) (str-join sep (tail parts)) true nil)))
  (defn pim-before (s sep) (first (str-split s sep)))
  (defn pim-number? (s) (and (string? s) (str-matches s "^-?[0-9]+(\\.[0-9]+)?$")))
  (defn pim-words (s) (filter (fn (w) (!= w "")) (str-split (str-trim s) " ")))

  ;; A line as (indent state body): state is "todo", "done", "item" (a bullet) or "text".
  (defn pim-parse (line)
    (let (ind (pim-indent line)
          s   (substr line (str-len ind)))
      (cond (str-starts-with s "- [ ] ") (list ind "todo" (substr s 6))
            (str-starts-with s "- [x] ") (list ind "done" (substr s 6))
            (str-starts-with s "- [X] ") (list ind "done" (substr s 6))
            (str-starts-with s "- ")     (list ind "item" (substr s 2))
            (str-starts-with s "* ")     (list ind "item" (substr s 2))
            true                         (list ind "text" s))))

  ;; The bits a task line carries: " {#12}" links it to agenda item 12, " ✓ 2026-09-30" is when
  ;; it was done, a leading "!!!"/"!!"/"!" its priority (what the agenda's smart parser reads).
  (defn pim-item-id (body)
    (let (r (pim-rest-after body "{#"))
      (cond (nil? r) nil
            (pim-number? (pim-before r "}")) (->number (pim-before r "}"))
            true nil)))
  (defn pim-unstamp (body) (str-trim (pim-before body " ✓ ")))
  (defn pim-unlink (body)
    (let (id (pim-item-id body))
      (cond (nil? id) body
            true (str-trim (str-replace body (str "{#" id "}") "")))))
  (defn pim-bangs (body)
    (let (w (first (pim-words body)))
      (cond (= w "!!!") "!!!" (= w "!!") "!!" (= w "!") "!" true "")))
  (defn pim-unbang (body)
    (let (b (pim-bangs body))
      (cond (= b "") body true (str-trim (substr (str-trim body) (str-len b))))))
  ;; The words of a task, with every marker gone — what a clock or the done log records.
  (defn pim-title (body) (pim-unbang (pim-unlink (pim-unstamp body))))

  (defn pim-log-done (task id file)
    (insert done (dict :at *now* :day *date* :task task :item (or id 0) :file file)))

  ;; ── the agenda ─────────────────────────────────────────────────────────────
  (defn pim-live-ids () (map record-id (records (items))))
  (defn pim-live? (id) (some? (fn (x) (= x id)) (pim-live-ids)))
  (defn pim-tags (s)
    (map (fn (w) (substr w 1))
         (filter (fn (w) (str-matches w "^#[A-Za-z_][A-Za-z0-9_/-]*$")) (pim-words s))))
  (defn pim-untag (s) (str-join " " (filter (fn (w) (not (str-starts-with w "#"))) (pim-words s))))
  ;; defcategory doesn't evaluate its argument, so the name goes in as source. Defining it first
  ;; puts it in the agenda's category tree (the ⚙ panel, the item editor's list).
  (defn pim-file-under (id cats)
    (for-each c cats
      (eval (parse (str "(defcategory " c ")")))
      (assign id c)))
  (defn pim-said (d)
    (let (w (dict-get d :when))
      (str "Agenda #" (dict-get d :id) (cond (or (nil? w) (= w "")) " (no date)" true (str " on " w)))))

  ;; A task into the agenda. The words are parsed there — "tomorrow", "in 3 days", "2026-10-12",
  ;; "urgent", "!!", "@Ana" — each #tag (and each of cats) files it under that category,
  ;; " | …" becomes its notes, and your rules run over it. Returns the item as a dict.
  (defn pim-add (text cats)
    (let (s     (pim-before text " | ")
          notes (pim-rest-after text " | ")
          id    (dict-get (item->dict (add (pim-untag s))) :id))
      (when notes (item-set id :notes (str-trim notes)))
      (pim-file-under id (append (pim-tags s) cats))
      (apply-rules id)
      (item->dict (item-get id))))

  ;; A linked line edited in the note → the item follows: text, date, priority, notes, tags.
  (defn pim-resync (id body)
    (let (plain  (pim-unstamp (pim-unlink body))
          s      (pim-before plain " | ")
          notes  (pim-rest-after plain " | ")
          parsed (smart-parse (pim-untag s)))
      (item-set id :text (dict-get parsed :text))
      (when (dict-get parsed :when) (item-set id :when (dict-get parsed :when)))
      (when (dict-get parsed :priority) (item-set id :priority (dict-get parsed :priority)))
      (when notes (item-set id :notes (str-trim notes)))
      (pim-file-under id (pim-tags s))
      (apply-rules id)
      (ed-message (str "Updated " (pim-said (item->dict (item-get id)))))))

  ;; ── TODO cycling (org C-c C-t) ─────────────────────────────────────────────
  ;; text → - [ ] … {#12} → - [x] … ✓ date → - …
  ;; Making the task adds it to the agenda; ticking it is item-done there. A repeating item's line
  ;; stays open and points at the next occurrence. A "- [ ]" you typed by hand has no {#id}: ⌘⌥A
  ;; links it; ticked unlinked, it's just ticked. Back to "- ", the line lets go of its item.
  (defn pim-cycle (line)
    (let (p (pim-parse line) ind (nth p 0) state (nth p 1) body (nth p 2))
      (cond
        (or (= state "text") (= state "item"))
          (let (plain (pim-unlink body))
            (cond (= (pim-title plain) "") (pim-set-line (str ind "- [ ] "))
                  true (let (d (pim-add plain (list)))
                         (list (pim-set-line (str ind "- [ ] " plain " {#" (dict-get d :id) "}"))
                               (ed-message (pim-said d))))))
        (= state "todo")
          (let (id   (pim-item-id body)
                next (cond (nil? id) false true (item-done id)))
            (pim-log-done (pim-title body) id *file*)
            (cond (= (type next) "item")
                    (let (d (item->dict next))
                      (list (pim-set-line (str ind "- [ ] " (str-replace body (str "{#" id "}")
                                                                          (str "{#" (dict-get d :id) "}"))))
                            (ed-message (str "Done — next one " (dict-get d :when)))))
                  true (list (pim-set-line (str ind "- [x] " body " ✓ " *date*)))))
        true
          (list (pim-set-line (str ind "- " (pim-unlink (pim-unstamp body))))))))

  ;; ── priority (org S-up / S-down) ───────────────────────────────────────────
  ;; On a linked line the item's priority changes too.
  (defn pim-next-bangs (b) (cond (= b "") "!!!" (= b "!!!") "!!" (= b "!!") "!" true ""))
  (def pim-bang-priority (dict :!!! 1 :!! 2 :! 3))
  (defn pim-priority (line)
    (let (p (pim-parse line) ind (nth p 0) state (nth p 1) body (nth p 2)
          nb (pim-next-bangs (pim-bangs body))
          b2 (str (cond (= nb "") "" true (str nb " ")) (pim-unbang body))
          id (pim-item-id body)
          head (cond (= state "todo") "- [ ] " (= state "done") "- [x] " (= state "item") "- " true ""))
      (when (and id (pim-live? id))
        (item-set id :priority (cond (= nb "") "" true (dict-get pim-bang-priority nb))))
      (pim-set-line (str ind head b2))))

  ;; ── ⌘⌥A: link or update (org SCHEDULED/DEADLINE) ───────────────────────────
  (defn pim-schedule (line)
    (let (p (pim-parse line) ind (nth p 0) body (nth p 2) id (pim-item-id body))
      (cond
        (= (pim-title body) "") (ed-message "Nothing to schedule on this line")
        (nil? id)
          (let (d (pim-add (pim-unstamp body) (list)))
            (list (pim-set-line (str ind "- [ ] " (pim-unstamp body) " {#" (dict-get d :id) "}"))
                  (ed-message (pim-said d))))
        (not (pim-live? id)) (ed-message (str "#" id " isn't in the agenda any more — ⌘⌥U ticks it here"))
        true (pim-resync id body))))

  ;; ── views (org-agenda) ─────────────────────────────────────────────────────
  (defn pim-bang-of (pr) (cond (= pr "1") "!!! " (= pr "2") "!! " (= pr "3") "! " true ""))
  (defn pim-item-line (r)
    (str "- [ ] " (pim-bang-of (field-get r :priority)) (field-get r :text) " {#" (record-id r) "}"
         (cond (= (field-get r :categories) "") "" true (str "  _" (field-get r :categories) "_"))))
  (defn pim-by-priority (rows)
    (sort-by (fn (r) (let (p (field-get r :priority)) (cond (= p "") 9 true (->number p)))) rows))
  (defn pim-lines (rows empty)
    (cond (empty? rows) empty true (str-join "\n" (map pim-item-line (pim-by-priority rows)))))
  ;; Overdue (the pim-overdue view), then each of the next n days (items-between, what the
  ;; calendar reads), by priority. Days with nothing are left out, except today.
  (defn pim-agenda (n)
    (let (overdue  (records (show pim-overdue))
          upcoming (records (items-between *date* (date-add *date* (- n 1) :days)))
          days     (map (fn (i) (date-add *date* i :days)) (range 0 n 1)))
      (str-join "\n"
        (filter (fn (s) (!= s ""))
          (cons (cond (empty? overdue) ""
                      true (str "**Overdue**\n\n" (pim-lines overdue "") "\n"))
                (map (fn (day)
                       (let (on (filter (fn (r) (= (field-get r :when) day)) upcoming))
                         (cond (and (empty? on) (!= day *date*)) ""
                               true (str "**" (date-format day "EEE d MMM") (cond (= day *date*) " — today" true "") "**\n\n"
                                         (pim-lines on "_nothing scheduled_") "\n"))))
                     days))))))
  ;; Items with no date — org's unscheduled TODOs.
  (defn pim-someday ()
    (pim-lines (filter (fn (r) (= (field-get r :when) "")) (records (items))) "_nothing undated_"))
  ;; What capture put in the inbox, still to sort — the pim-inbox view.
  (defn pim-inbox () (pim-lines (records (show pim-inbox)) "_inbox empty_"))
  ;; One category and its children — "work" takes in "work/calls", which (items :category …)
  ;; alone doesn't.
  (defn pim-in? (c r)
    (some? (fn (x) (or (= x c) (str-starts-with x (str c "/"))))
           (str-split (field-get r :categories) ", ")))
  (defn pim-category (c)
    (pim-lines (filter (fn (r) (pim-in? c r)) (records (items))) (str "_nothing in " c "_")))

  ;; Lines whose item was finished elsewhere — the agenda panel's Done, the REPL — are ticked here.
  (defn pim-sync-in (text file live)
    (str-join "\n"
      (map (fn (l)
             (let (p (pim-parse l) id (pim-item-id (nth p 2)))
               (cond (and (= (nth p 1) "todo") id (not (some? (fn (x) (= x id)) live)))
                       (do (pim-log-done (pim-title (nth p 2)) id file)
                           (str (nth p 0) "- [x] " (nth p 2) " ✓ " *date*))
                     true l)))
           (str-split text "\n"))))
  (defn pim-sync (text) (pim-sync-in text *file* (pim-live-ids)))

  ;; ── every note at once ─────────────────────────────────────────────────────
  ;; (notes) lists the workspace's notes and (read-note p) reads one, as saved — and EEditor saves
  ;; open tabs before a key or a tick runs. A note is rewritten with (ed-write p new old): if you
  ;; typed into it in the meantime it's left alone, and the next sweep gets it.
  (defn pim-agenda-file? (path)
    (some? (fn (f) (or (= path f) (str-starts-with path (str f "/")))) pim-agenda-files))
  ;; Unlinked "- [ ] …" lines become agenda items.
  (defn pim-link-new (text)
    (str-join "\n"
      (map (fn (l)
             (let (p (pim-parse l) body (nth p 2))
               (cond (and (= (nth p 1) "todo") (nil? (pim-item-id body)) (!= (pim-title body) ""))
                       (str (nth p 0) "- [ ] " body " {#" (dict-get (pim-add (pim-unstamp body) (list)) :id) "}")
                     true l)))
           (str-split text "\n"))))
  ;; One note: ticked where its items are done, and (link? and an agenda file) its new tasks linked.
  ;; An editor command, or nil when the note doesn't change.
  (defn pim-sweep-note (path live link?)
    (let (old (or (read-note path) ""))
      (cond (not (str-contains old "- [ ] ")) nil   ;; most notes: nothing to look at
            true (let (linked (cond (and link? (pim-agenda-file? path)) (pim-link-new old) true old)
                       new (pim-sync-in linked path live))
                   (cond (= new old) nil true (ed-write path new old))))))
  (defn pim-sweep (link?)
    (let (live (pim-live-ids))
      (filter (fn (c) (not (nil? c))) (map (fn (p) (pim-sweep-note p live link?)) (notes)))))
  (defn pim-sweep-now ()
    (let (changed (pim-sweep true))
      (cons (ed-message (cond (empty? changed) "Every note is in step with the agenda"
                              true (str "Brought " (length changed) " note" (cond (= (length changed) 1) "" true "s")
                                        " in step with the agenda")))
            changed)))

  ;; ── dynamic blocks (org #+BEGIN: … #+END) ──────────────────────────────────
  ;;   <!-- eel: (pim-agenda 7) -->
  ;;   …whatever the expression returns, rewritten by ⌘⌥U…
  ;;   <!-- /eel -->
  ;; The markers are HTML comments, so the preview and the PDF show only the result.
  (def pim-open  "<!-- eel:")
  (def pim-close "<!-- /eel -->")
  (defn pim-block (expr) (str pim-open " " expr " -->\n" (eval (parse expr)) "\n" pim-close))
  ;; A new block takes the caret's line when that is empty or only a bullet (Enter on a list
  ;; line has already typed "- [ ] "), otherwise it goes on the line below.
  (defn pim-insert-block (expr)
    (cond (= (pim-title (nth (pim-parse *line-text*) 2)) "") (pim-set-line (pim-block expr))
          true (ed-replace-range *line-to* *line-to* (str "\n" (pim-block expr)))))
  (defn pim-update-blocks (text)
    (let (parts (str-split text pim-open))
      (str (first parts)
           (str-join ""
             (map (fn (part)
                    (let (expr  (str-trim (pim-before part "-->"))
                          after (pim-rest-after part "-->")
                          rest  (cond (nil? after) "" true (pim-rest-after after pim-close)))
                      ;; no closing marker: keep what followed, the block is inserted above it
                      (str (pim-block expr) (cond (nil? rest) (str "\n" after) true rest))))
                  (tail parts))))))

  ;; ── clock (org C-c C-x C-i / C-o) ──────────────────────────────────────────
  (defn pim-running () (records (query clock :where "stop = ?" :params (list 0))))
  (defn pim-mins (r) (round (/ (- (now) (field-get r :start)) 60)))
  ;; A linked task's total goes on its agenda item as :clocked "h:mm" (item->dict shows it).
  (defn pim-note-clocked (id)
    (when (and (> id 0) (pim-live? id))
      (item-set id :clocked
        (pim-hm (reduce (fn (a r) (+ a (field-get r :mins))) 0
                        (records (query clock :where "item = ? AND stop > 0" :params (list id))))))))
  (defn pim-stop-clocks ()
    (map (fn (r)
           (update clock (record-id r) (dict :stop (now) :mins (pim-mins r)))
           (pim-note-clocked (field-get r :item))
           (str (field-get r :task) " — " (pim-mins r) " min"))
         (pim-running)))
  (defn pim-task-at (line)
    (let (s (str-trim line))
      (cond (str-starts-with s "#") (str-trim (str-join " " (tail (str-split s " "))))
            true (pim-title (nth (pim-parse line) 2)))))
  (defn pim-item-at (line)
    (cond (str-starts-with (str-trim line) "#") 0 true (or (pim-item-id (nth (pim-parse line) 2)) 0)))
  (defn pim-clock-in (line)
    (let (task (pim-task-at line))
      (cond (= task "") (ed-message "Put the caret on a task or a heading first")
            true (let (stopped (pim-stop-clocks))
                   (insert clock (dict :task task :item (pim-item-at line) :file *file* :day *date*
                                       :start (now) :stop 0 :mins 0))
                   (ed-message (str "⏱ " task (cond (empty? stopped) "" true (str "  (stopped " (first stopped) ")"))))))))
  (defn pim-clock-out ()
    (let (stopped (pim-stop-clocks))
      (ed-message (cond (empty? stopped) "No clock running" true (str "Stopped " (first stopped))))))
  (defn pim-clock-status ()
    (let (r (pim-running))
      (ed-message (cond (empty? r) "No clock running"
                        true (str "⏱ " (field-get (first r) :task) " — " (pim-mins (first r)) " min")))))
  (defn pim-hm (m) (str (floor (/ m 60)) ":" (let (x (mod (round m) 60)) (cond (< x 10) (str "0" x) true x))))
  ;; Time per task between two days (inclusive), as a markdown table — org's clock report.
  (defn pim-clock-report (from to)
    (let (rows  (records (query clock :where "day >= ? AND day <= ? AND stop > 0" :params (list from to)))
          tasks (reduce (fn (acc r) (cond (some? (fn (x) (= x (field-get r :task))) acc) acc
                                          true (append acc (list (field-get r :task)))))
                        (list) rows)
          sum-of (fn (task) (reduce (fn (a r) (cond (= (field-get r :task) task) (+ a (field-get r :mins)) true a)) 0 rows))
          total (reduce (fn (a r) (+ a (field-get r :mins))) 0 rows))
      (cond (empty? rows) "_no time clocked_"
            true (str "| task | time |\n|---|---:|\n"
                      (str-join "\n" (map (fn (task) (str "| " task " | " (pim-hm (sum-of task)) " |"))
                                          (sort-by (fn (task) (- 0 (sum-of task))) tasks)))
                      "\n| **total** | **" (pim-hm total) "** |"))))

  ;; ── done log / archive (org C-c C-x C-a) ───────────────────────────────────
  (defn pim-done-report (from to)
    (let (rows (records (query done :where "day >= ? AND day <= ?" :params (list from to) :order "at")))
      (cond (empty? rows) "_nothing finished_"
            true (str-join "\n" (map (fn (r) (str "- " (field-get r :day) "  " (field-get r :task))) rows)))))
  ;; Every "- [x]" line of the note moves under "## Archive" at its end.
  (defn pim-archive (text)
    (let (lines (str-split text "\n")
          done? (fn (l) (= (nth (pim-parse l) 1) "done"))
          moved (filter done? lines)
          kept  (filter (fn (l) (not (done? l))) lines)
          body  (str-join "\n" kept))
      (cond (empty? moved) nil
            (str-contains body "\n## Archive") (str body "\n" (str-join "\n" moved) "\n")
            true (str (str-trim body) "\n\n## Archive\n\n" (str-join "\n" moved) "\n"))))

  ;; ── life tracker ───────────────────────────────────────────────────────────
  ;; You type the thing; its kind is looked up, so "coffee" is enough. Extend the dicts freely.
  (def pim-kinds (dict :coffee "drink" :espresso "drink" :tea "drink" :water "drink" :beer "drink" :wine "drink"
                       :cigar "smoke" :cigarette "smoke"
                       :weed "weed" :joint "weed" :bong "weed"
                       :run "exercise" :walk "exercise" :gym "exercise" :swim "exercise" :yoga "exercise"
                       :bike "exercise" :stretch "exercise"
                       :sleep "sleep" :weight "body" :mood "mood"))
  (def pim-units (dict :drink "un" :smoke "un" :weed "un" :exercise "min" :food "kcal"
                       :sleep "h" :body "kg" :mood "/10"))
  ;; The kind of the first word the dict knows: "red wine" is a drink, "🍕 pizza" is food.
  (defn pim-kind-of (thing)
    (let (known (filter (fn (w) (dict-has pim-kinds w)) (pim-words thing)))
      (cond (empty? known) "food" true (dict-get pim-kinds (first known)))))
  (defn pim-unit-of (kind) (cond (dict-has pim-units kind) (dict-get pim-units kind) true "un"))

  (defn track (thing qty unit note)
    (let (k (pim-kind-of thing)
          u (cond (= unit "") (pim-unit-of k) true unit))
      (insert log (dict :at *now* :day *date* :kind k :item thing :qty qty :unit u :note note))
      (str thing " " qty " " u (cond (= note "") "" true (str " | " note)))))

  ;; "red wine 2 glass | with Ana" → ("red wine" 2 "glass" "with Ana"): the thing is every word
  ;; before the first number. "walk 30" → ("walk" 30 "" ""), "joint" → ("joint" 1 "" "").
  (defn pim-parse-log (s)
    (let (note (let (n (pim-rest-after s " | ")) (cond (nil? n) "" true (str-trim n)))
          w    (pim-words (pim-before s " | "))
          ws   (loop (i 0) (cond (>= i (length w)) i (pim-number? (nth w i)) i true (recur (inc i)))))
      (list (str-lower (str-join " " (take ws w)))
            (cond (< ws (length w)) (->number (nth w ws)) true 1)
            (cond (< (+ ws 1) (length w)) (nth w (+ ws 1)) true "")
            note)))
  (defn pim-track (s) (apply track (pim-parse-log s)))

  (defn pim-track-line (line)
    (let (p (pim-parse line) ind (nth p 0) body (nth p 2))
      (cond (str-matches (str-trim line) "^- [0-9][0-9]:[0-9][0-9]  ") (ed-message "Already logged")
            (or (= (str-trim body) "") (pim-number? (first (pim-words body)))) (ed-message "Nothing to log on this line")
            true (pim-set-line (str ind "- " *time* "  " (pim-track body))))))

  (defn pim-total (rows kind)
    (reduce (fn (a r) (cond (= (field-get r :kind) kind) (+ a (field-get r :qty)) true a)) 0 rows))
  (defn pim-track-report (from to)
    (let (rows  (records (query log :where "day >= ? AND day <= ?" :params (list from to) :order "at"))
          kinds (reduce (fn (acc r) (cond (some? (fn (k) (= k (field-get r :kind))) acc) acc
                                          true (append acc (list (field-get r :kind)))))
                        (list) rows))
      (cond (empty? rows) "_nothing logged_"
            true (str-join " · " (map (fn (k) (str k " " (pim-total rows k) " "
                                                   (field-get (first (filter (fn (r) (= (field-get r :kind) k)) rows)) :unit)))
                                      kinds)))))
  (defn pim-day-log (day)
    (let (rows (records (query log :where "day = ?" :params (list day) :order "at")))
      (cond (empty? rows) "_nothing logged_"
            true (str (str-join "\n" (map (fn (r) (str "- " (substr (field-get r :at) 11 16) "  " (field-get r :item)
                                                      " " (field-get r :qty) " " (field-get r :unit)
                                                      (cond (= (field-get r :note) "") "" true (str " | " (field-get r :note)))))
                                          rows))
                      "\n\n" (pim-track-report day day)))))
  ;; Days in a row, ending today (or yesterday, if today has nothing yet), with this kind logged.
  (defn pim-streak (kind)
    (let (has? (fn (d) (> (count-records log :where "kind = ? AND day = ?" :params (list kind d)) 0))
          from (cond (has? *date*) *date* true (date-add *date* -1 :days)))
      (loop (d from n 0)
        (cond (has? d) (recur (date-add d -1 :days) (inc n)) true n))))

  ;; ── notes: daily and weekly (org-journal, the weekly review) ───────────────
  (def pim-weekday (dict :Monday 0 :Tuesday 1 :Wednesday 2 :Thursday 3 :Friday 4 :Saturday 5 :Sunday 6))
  (defn pim-monday (day) (date-add day (- 0 (dict-get pim-weekday (date-format day "EEEE"))) :days))
  (defn pim-daily-template (day)
    (str "# " day " · " (date-format day "EEEE") "\n\n"
         "## Agenda\n\n" (pim-block "(pim-agenda 1)") "\n\n"
         "## Log\n\n\n"
         "## Notes\n\n"))
  (defn pim-weekly-template (monday)
    (let (sunday (date-add monday 6 :days)
          q (fn (f) (str "(" f " \"" monday "\" \"" sunday "\")")))
      (str "# Week of " monday "\n\n"
           "## Done\n\n"          (pim-block (q "pim-done-report")) "\n\n"
           "## Time\n\n"          (pim-block (q "pim-clock-report")) "\n\n"
           "## Tracker\n\n"       (pim-block (q "pim-track-report")) "\n\n"
           "## Coming up\n\n"     (pim-block "(pim-agenda 7)") "\n\n"
           "## Inbox\n\n"         (pim-block "(pim-inbox)") "\n\n"
           "## Undated\n\n"       (pim-block "(pim-someday)") "\n\n"
           "## Reflection\n\n- What went well?\n- What didn't?\n- What matters next week?\n")))

  ;; ── capture (org-capture) — used by pim/Capture.eeform ─────────────────────
  ;; A line filed under a heading of a note (pim-capture-to says which): "today" is the daily note,
  ;; made from its template first if it isn't there yet.
  (defn pim-note-path (where) (cond (= where "today") (str *date* ".md") true where))
  (defn pim-file-line (kind line)
    (let (to (dict-get pim-capture-to kind)
          path (pim-note-path (first to))
          make (cond (and (= (first to) "today") (nil? (read-note path))) (list (ed-write path (pim-daily-template *date*)))
                     true (list)))
      (cond (nil? to) (list) true (append make (list (ed-append path line (second to)))))))
  ;; (message commands): what to say, and the editor commands that file the line.
  (defn pim-capture* (kind text)
    (let (s (str-trim text))
      (cond (= s "") (list "Nothing to capture" (list))
            (= kind "log") (let (logged (pim-track s))
                             (list (str "Logged " logged) (pim-file-line kind (str "- " *time* "  " logged))))
            true (let (d (pim-add s (cond (= kind "inbox") (list "inbox") true (list))))
                   (list (pim-said d) (pim-file-line kind (str "- [ ] " s " {#" (dict-get d :id) "}")))))))
  (defn pim-capture (kind text) (first (pim-capture* kind text)))

  ;; ── refile (org C-c C-w) ───────────────────────────────────────────────────
  ;; Every heading in every note, as "path › ## Heading" — and each note on its own, for its end.
  (defn pim-headings (path)
    (map (fn (l) (str path " › " (str-trim l)))
         (filter (fn (l) (str-matches l "^#{1,6} ")) (str-split (or (read-note path) "") "\n"))))
  (defn pim-refile-targets ()
    (reduce (fn (acc p) (append acc (cons p (pim-headings p)))) (list) (notes)))
  ;; The caret's line moves to the target; the agenda item, if it has one, goes with it.
  (defn pim-refile (target)
    (let (path (str-trim (pim-before target " › "))
          heading (pim-rest-after target " › "))
      (cond (= (str-trim *line-text*) "") (ed-message "Nothing to refile on this line")
            (not (str-contains path ".")) (ed-message (str "Refile to a note, like inbox.md — not " path))
            true (list (ed-replace-range *line-from* (+ *line-to* 1) "")
                       (ed-append path (str-trim *line-text*) (or heading ""))
                       (ed-message (str "Refiled to " target))))))

  ;; ── asked for (the prompt) ─────────────────────────────────────────────────
  ;; ⌘⌥E: a date for the caret's task, in the words the agenda reads; "none" takes it away.
  (defn pim-set-when (answer)
    (let (id (pim-item-id (nth (pim-parse *line-text*) 2))
          a (str-trim answer))
      (cond (nil? id) (ed-message "Not an agenda task — ⌘⌥T makes it one")
            (not (pim-live? id)) (ed-message (str "#" id " isn't in the agenda any more"))
            (some? (fn (x) (= x (str-lower a))) (list "none" "-" "no date"))
              (do (item-set id :when "") (ed-message (str "#" id " has no date now")))
            true (let (w (dict-get (smart-parse (str "x " a)) :when))
                   (cond (nil? w) (ed-message (str "\"" a "\" isn't a date I know"))
                         true (do (item-set id :when w) (ed-message (pim-said (item->dict (item-get id))))))))))
  ;; ⌘⌥G: a category for it, picked from the agenda's (or a new one).
  (defn pim-category-names () (filter (fn (c) (!= c "")) (map str-trim (str-split (categories) "\n"))))
  (defn pim-set-category (answer)
    (let (id (pim-item-id (nth (pim-parse *line-text*) 2))
          c (str-trim answer))
      (cond (nil? id) (ed-message "Not an agenda task — ⌘⌥T makes it one")
            (not (pim-live? id)) (ed-message (str "#" id " isn't in the agenda any more"))
            (not (str-matches c "^[A-Za-z_][A-Za-z0-9_/-]*$")) (ed-message (str "\"" c "\" can't be a category name"))
            true (do (pim-file-under id (list c))
                     (ed-message (str "#" id " filed under " c))))))

  ;; ── reminders ──────────────────────────────────────────────────────────────
  ;; An item for today with a time — "call Ana at 15:00", or (item-set 12 :remind "14:45") —
  ;; notifies you then (EEditor has to be running). Each one once.
  (defn pim-mins-of (hm)   ;; "15:05" → 905
    (let (p (str-split hm ":")) (+ (* 60 (->number (first p))) (->number (second p)))))
  (defn pim-time-in (text)
    (let (t (filter (fn (w) (str-matches w "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"))
                    (map (fn (w) (str-trim (str-replace (str-replace w "," "") "." ""))) (pim-words text))))
      (cond (empty? t) nil true (first t))))
  (defn pim-remind-at (r)
    (let (d (item->dict (item-get (record-id r))) explicit (dict-get d :remind))
      (cond (and explicit (!= explicit "")) explicit true (pim-time-in (field-get r :text)))))
  (defn pim-due-reminders ()
    (let (now (pim-mins-of *time*))
      (filter (fn (r)
                (let (at (pim-remind-at r))
                  (and at
                       (<= (pim-mins-of at) now)
                       (< (- now (pim-mins-of at)) pim-remind-grace)
                       (= 0 (count-records reminded :where "item = ? AND day = ?" :params (list (record-id r) *date*))))))
              (records (items-on *date*)))))
  (defn pim-reminders ()
    (map (fn (r)
           (insert reminded (dict :item (record-id r) :day *date* :at *now*))
           (ed-notify (str "⏰ " (pim-remind-at r)) (field-get r :text)))
         (pim-due-reminders)))

  ;; What (on-tick …) runs, once a minute.
  (defn pim-tick ()
    (append (pim-reminders) (cond pim-sweep-every-minute (pim-sweep false) true (list))))

)

;; What opens at launch: today's note, made from the template the first time.
(on-start (ed-new (str *date* ".md") (pim-daily-template *date*)))

;; Once a minute: reminders that are due, and lines ticked where their item was finished.
(on-tick (pim-tick))

;; ── keys ─────────────────────────────────────────────────────────────────────
;; ⌘⌥ + a letter ("Mod-Alt-": Ctrl+Alt on Windows and Linux), so nothing of the app's or
;; CodeMirror's is taken. Not ⌘⌥D: macOS keeps that one for hiding the Dock, so the date is ⌘⌥E.

;; ⌘D — today's note, created from the template the first time
(bind "Mod-d" (ed-new (str *date* ".md") (pim-daily-template *date*)))

;; ⌘⌥T — cycle the caret's line: text → - [ ] {#id} (an agenda item) → - [x] ✓ date (done there too) → -
(bind "Mod-Alt-t" (pim-cycle *line-text*))
;; ⌘⌥P — cycle its priority: !!! → !! → ! → none
(bind "Mod-Alt-p" (pim-priority *line-text*))
;; ⌘⌥A — link a hand-typed task to the agenda, or push an edited linked line to its item
(bind "Mod-Alt-a" (pim-schedule *line-text*))
;; ⌘⌥W — the next seven days, as a block ⌘⌥U keeps fresh
(bind "Mod-Alt-w" (pim-insert-block "(pim-agenda 7)"))
;; ⌘⌥U — recompute every <!-- eel: … --> block, and tick the lines finished in the agenda
(bind "Mod-Alt-u" (ed-set-buffer (pim-sync (pim-update-blocks *buffer*))) (ed-goto *cursor*))
;; ⌘⌥X — move the finished tasks to "## Archive" at the end of the note
(bind "Mod-Alt-x"
  (let (next (pim-archive *buffer*))
    (cond (nil? next) (ed-message "No finished tasks here")
          true (list (ed-set-buffer next) (ed-goto *cursor*)))))

;; ⌘⌥I / ⌘⌥O / ⌘⌥K — clock in on the task or heading at the caret, clock out, what's running
(bind "Mod-Alt-i" (pim-clock-in *line-text*))
(bind "Mod-Alt-o" (pim-clock-out))
(bind "Mod-Alt-k" (pim-clock-status))

;; ⌘⌥L — log the caret's line to the tracker ("coffee 2", "walk 30", "rice 550 kcal | lunch")
(bind "Mod-Alt-l" (pim-track-line *line-text*))
;; ⌘⌥C — one keystroke for the thing you do twenty times a day
(bind "Mod-Alt-c" (ed-message (str "Logged " (track "coffee" 1 "" ""))))
;; ⌘⌥R — today's tracker log at the caret
(bind "Mod-Alt-r" (pim-insert-block (str "(pim-day-log \"" *date* "\")")))

;; ⌘⌥V — this week's review note, filled in
(bind "Mod-Alt-v"
  (ed-new (str "reviews/" (pim-monday *date*) " week.md") (pim-weekly-template (pim-monday *date*))))
;; ⌘⌥N — capture from anywhere: a small window, type, Enter
(bind "Mod-Alt-n" (ed-form "pim/Capture"))

;; ⌘⌥S — every note in step with the agenda: lines whose items were finished are ticked, and in
;; pim-agenda-files the hand-typed "- [ ]" lines become items
(bind "Mod-Alt-s" (pim-sweep-now))
;; ⌘⌥F — refile the caret's line under a heading of any note (type to narrow the list)
(bind "Mod-Alt-f" (ed-prompt "Refile to" pim-refile "" (pim-refile-targets)))
;; ⌘⌥E — a date for the caret's task: "tomorrow", "in 3 days", "2026-10-12", "none"
(bind "Mod-Alt-e" (ed-prompt "When?" pim-set-when))
;; ⌘⌥G — file the caret's task under a category
(bind "Mod-Alt-g" (ed-prompt "Category" pim-set-category "" (pim-category-names)))

(on-load
  (set! pim-agenda-files (list "inbox.md" "projects")))

;; ══ Zero to Hero — chapter 6. A dashboard ══════════════════════════════

;; ⌘⇧D — the dashboard, fresh
(bind "Mod-Shift-d"
  (ed-write "dashboard.md" (pim-update-blocks (read-note "dashboard.md")))
  (ed-open "dashboard.md"))

;; ══ Zero to Hero — chapter 7. Tables ══════════════════════════════

(on-load
  (deftable accounts (name:string kind:string currency:string))
  (deftable transactions
    (day:string account:string amount:number (category :type string :default "other") note:string))
  (deftable holdings
    (symbol:string (kind :type choice :choices ("crypto" "stock" "fx")) qty:number cost:number))

  (defn amounts (rows) (map (fn (r) (field-get r :amount)) rows))
  (defn spent (from to)
    (round (- 0 (sum (filter (fn (a) (< a 0))
                             (amounts (records (query transactions
                                                      :where "day >= ? AND day <= ? AND category != ?"
                                                      :params (list from to "savings")))))))
           2))

  (def default-account "Card")

  ;; "coffee 3.50 #food" → {:amount -3.5 :category "food" :note "coffee"}
  ;; "+3200 salary #salary" → money in: {:amount 3200 …}
  (defn parse-spend (line)
    (let (words (filter (fn (w) (!= w "")) (str-split (line-words line) " "))
          num   (first (filter (fn (w) (str-matches w "^[+-]?[0-9]+([.,][0-9]+)?$")) words))
          tag   (first (filter (fn (w) (str-starts-with w "#")) words))
          rest  (filter (fn (w) (and (!= w num) (!= w tag))) words))
      (if (nil? num)
          nil
          {:amount   (let (n (->number (str-replace (str-replace num "+" "") "," ".")))
                       (if (str-starts-with num "+") n (- 0 n)))
           :category (if (nil? tag) "other" (substr tag 1 (str-len tag)))
           :note     (str-join " " rest)})))

  (defn spend-line (line)
    (let (t (parse-spend line))
      (if (nil? t)
          (ed-message "No amount on this line — write it like: coffee 3.50 #food")
          (do (insert transactions (dict-merge t {:day *date* :account default-account}))
              (ed-message (str (if (> (dict-get t :amount) 0) "In: " "Spent: ")
                               (abs (dict-get t :amount)) " · " (dict-get t :category))))))))

;; ⌘⇧E — the caret's line, as a transaction
(bind "Mod-Shift-e" (spend-line *line-text*))

;; ══ Zero to Hero — chapter 8. Forms ══════════════════════════════

;; ⌘⇧U — the transactions form, in its own window
(bind "Mod-Shift-u" (ed-form "Transactions"))

;; ══ Zero to Hero — chapter 9. Sheets ══════════════════════════════

(on-load
  ;; rewrite the Ledger from the transactions table, then recalculate the Budget
  (defn ledger-refresh ()
    (let (old (length (sheet-rows "Ledger" "A:A")))
      (do (if (> old 0) (sheet-delete-rows "Ledger" 1 old) nil)
          (sheet-put "Ledger" "A1" (query transactions :order "day"))
          (sheet-recalc "Budget")
          (count-records transactions)))))

;; ⌘⇧L — the Ledger and the Budget, up to date
(bind "Mod-Shift-l" (ed-message (str "Ledger: " (ledger-refresh) " transactions")))

;; ══ Zero to Hero — chapter 10. Fetching prices ══════════════════════════════

(on-load
  (deftable prices (symbol:string kind:string price:number currency:string at:string source:string))
  (def crypto-ids (list "bitcoin" "ethereum"))
  (def fx-to (list "EUR" "BRL" "GBP"))

  (defn fetch-json (url)
    (let (r (http-get url))
      (if (= (dict-get r :status) 200) (json-parse (dict-get r :body)) nil)))

  (defn fetch-crypto ()
    (let (data (fetch-json (str "https://api.coingecko.com/api/v3/simple/price?ids="
                                (str-join "," crypto-ids) "&vs_currencies=usd")))
      (if (nil? data) 0
          (length (map (fn (id)
                         (insert prices {:symbol id :kind "crypto" :currency "USD" :source "coingecko"
                                         :price (dict-get (dict-get data id) :usd) :at *now*}))
                       crypto-ids)))))

  (defn fetch-fx ()
    (let (data (fetch-json (str "https://api.frankfurter.app/latest?from=USD&to=" (str-join "," fx-to))))
      (if (nil? data) 0
          (length (map (fn (cur)
                         (insert prices {:symbol (str "USD/" cur) :kind "fx" :currency cur :source "frankfurter"
                                         :price (dict-get (dict-get data :rates) cur) :at *now*}))
                       fx-to)))))

  (defn latest (symbol)
    (let (rows (records (query prices :where "symbol = ?" :params (list symbol)
                                      :order "at" :desc true :limit 1)))
      (if (empty? rows) nil (field-get (first rows) :price))))

  ;; both sources; how many prices were saved
  (defn refresh-prices () (+ (fetch-crypto) (fetch-fx))))

;; ⌘⇧Q — fetch now, and say how it went
(bind "Mod-Shift-q"
  (let (n (refresh-prices))
    (ed-message (if (= n 0) "No prices — the services said no; try again in a minute" (str n " prices saved")))))

(bind "Mod-Shift-y"
  (ed-append (str *date* ".md")
             (str "- " *time* "  BTC " (latest "bitcoin") " USD · EUR " (latest "USD/EUR") "\n")
             "## Markets"))

;; ══ Zero to Hero — chapter 11. Keeping them fresh ══════════════════════════════

(on-load
  (def move-threshold 3)

  (defn latest-row (symbol)
    (first (records (query prices :where "symbol = ?" :params (list symbol)
                                  :order "at" :desc true :limit 1))))

  (defn previous (symbol)
    (let (last (latest-row symbol))
      (if (nil? last)
          nil
          (let (rows (records (query prices :where "symbol = ? AND at < ?"
                                            :params (list symbol (field-get last :at))
                                            :order "at" :desc true :limit 1)))
            (if (empty? rows) nil (field-get (first rows) :price))))))

  (defn change-pct (symbol)
    (let (now (latest symbol) before (previous symbol))
      (if (or (nil? now) (nil? before)) nil (round (* 100 (/ (- now before) before)) 2))))

  (defn moves ()
    (filter (fn (s) (let (c (change-pct s)) (and (not (nil? c)) (>= (abs c) move-threshold))))
            crypto-ids))

  (defn move-line (symbol)
    (let (c (change-pct symbol))
      (str "- " *time* "  " symbol " " (if (> c 0) "▲" "▼") " " (abs c) "% → " (latest symbol))))

  (defn day-of (at) (substr at 0 10))

  (defn prune-prices ()
    (let (cutoff (date-add *date* -7 :days)
          old    (records (query prices :where "at < ?" :params (list cutoff) :order "at" :desc true))
          kept   (list)
          gone   0)
      (do (for-each r old
            (let (key (str (field-get r :symbol) " " (day-of (field-get r :at))))
              (if (some? (fn (k) (= k key)) kept)
                  (do (delete prices (record-id r)) (set! gone (+ gone 1)))
                  (set! kept (cons key kept)))))
          gone)))

  ;; fetch, then one ed-append per symbol that moved — editor commands, for a key or a tick to carry out
  (defn market-round ()
    (do (refresh-prices)
        (if (= *time* "03:00") (prune-prices) nil)
        (map (fn (s) (ed-append (str *date* ".md") (str (move-line s) "\n") "## Markets"))
             (moves)))))

;; every 15 minutes: the whole round, quietly unless something moved
(on-tick
  (when (= (mod (->number (second (str-split *time* ":"))) 15) 0)
    (market-round)))

;; ══ Zero to Hero — chapter 12. A portfolio sheet ══════════════════════════════

(on-load
  (defn usd-to (currency amount)
    (let (rate (latest (str "USD/" currency)))
      (if (nil? rate) nil (round (* amount rate) 2))))

  (defn portfolio-row (n h)
    (list (field-get h :symbol) (field-get h :qty) (field-get h :cost)
          (str "=(latest A" n ")")
          (str "=(round (* B" n " D" n ") 2)")
          (str "=(round (- E" n " C" n ") 2)")
          (str "=(round (* 100 (/ F" n " C" n ")) 1)")))

  (defn portfolio-write ()
    (let (hs   (records (query holdings :order "symbol"))
          last (+ 1 (length hs))
          tot  (+ 2 last))
      (do (sheet-set "Portfolio" "A1"
            (append (list (list "Symbol" "Qty" "Cost" "Price" "Value" "Gain" "Gain %"))
                    (map (fn (i) (portfolio-row (+ i 2) (nth hs i))) (range (length hs)))
                    (list (list "" "" "" "" "" "" ""))))
          (sheet-set "Portfolio" (str "A" tot)
            (list (list "Total" "" (str "=(sum C2:C" last ")") ""
                        (str "=(round (sum E2:E" last ") 2)")
                        (str "=(round (sum F2:F" last ") 2)")
                        (str "=(round (* 100 (/ F" tot " C" tot ")) 1)"))
                  (list "In EUR" "" "" "" (str "=(usd-to \"EUR\" E" tot ")"))))
          tot)))

  ;; a column of the Total row, wherever it is now
  (defn portfolio-total (column)
    (let (labels (map first (sheet-rows "Portfolio" "A:A"))
          at     (first (filter (fn (i) (= (nth labels i) "Total")) (range (length labels)))))
      (if (nil? at) nil (sheet-get "Portfolio" (str column (+ at 1))))))

  ;; replaces chapter 10's: fetch, then bring the portfolio up to date
  (defn refresh-prices ()
    (let (n (+ (fetch-crypto) (fetch-fx)))
      (do (sheet-recalc "Portfolio") n))))

;; ⌘⇧P — rewrite the portfolio from the holdings table (after you buy or sell)
(bind "Mod-Shift-p"
  (do (portfolio-write)
      (ed-message (str "Portfolio: " (count-records holdings) " holdings, worth " (portfolio-total "E") " USD"))))

;; ══ Zero to Hero — chapter 13. Alerts as agenda items ══════════════════════════════

(on-load
  (deftable alerts (symbol:string direction:string level:number fired:string))
  (defcategory money/markets)

  (defn crossed? (a)
    (let (p (latest (field-get a :symbol)))
      (and (not (nil? p))
           (if (= (field-get a :direction) "below")
               (< p (field-get a :level))
               (> p (field-get a :level))))))

  (defn alert-text (a)
    (str (field-get a :symbol) " " (field-get a :direction) " " (field-get a :level) " — review"))

  (defn fire (a)
    (do (add-item (alert-text a) :when *date* :priority 1 :category "money/markets")
        (update alerts (record-id a) {:fired *date*})
        (ed-notify "Price alert" (str (alert-text a) " — now " (latest (field-get a :symbol))))))

  (defn check-alerts ()
    (map fire (filter (fn (a) (and (crossed? a) (!= (field-get a :fired) *date*)))
                      (records (query alerts)))))

  ;; replaces chapter 11's: the moves, and the alerts
  (defn market-round ()
    (do (refresh-prices)
        (if (= *time* "03:00") (prune-prices) nil)
        (append (map (fn (s) (ed-append (str *date* ".md") (str (move-line s) "\n") "## Markets"))
                     (moves))
                (check-alerts)))))

;; ⌘⇧J — fetch now, log the moves, check the alerts — and say so, even when nothing happened
(bind "Mod-Shift-j"
  (let (done (market-round))
    (append done (list (ed-message (if (empty? done)
                                       "Prices fetched — no moves, no alerts"
                                       (str "Prices fetched — " (length done) " moves or alerts")))))))

;; ══ Zero to Hero — chapter 14. The markets desk ══════════════════════════════

;; ⌘⇧M is meetings (chapter 2); the desk is ⌘⇧9 — nine to five, markets hours
(bind "Mod-Shift-9" (ed-form "MarketsDesk"))

;; ══ Zero to Hero — chapter 15. The weekly review ══════════════════════════════

(on-load
  (defn money-review (from to)
    (let (rows  (records (query transactions :where "day >= ? AND day <= ?" :params (list from to)))
          out   (filter (fn (r) (and (< (field-get r :amount) 0) (!= (field-get r :category) "savings"))) rows)
          in    (filter (fn (r) (> (field-get r :amount) 0)) rows)
          cats  (unique (map (fn (r) (field-get r :category)) out))
          total (fn (rs) (round (sum (map (fn (r) (abs (field-get r :amount))) rs)) 2)))
      (str "| Category | Spent | Times |\n|---|---|---|\n"
           (str-join "" (map (fn (c) (let (rs (filter (fn (r) (= (field-get r :category) c)) out))
                                       (str "| " c " | " (total rs) " | " (length rs) " |\n")))
                             cats))
           "\n**Spent** " (total out) " · **In** " (total in)
           " · **Portfolio** " (portfolio-total "E") " USD (" (portfolio-total "G") "% on cost)"
           " · **Open price alerts** " (length (records (items :category "money/markets"))))))

  ;; the PIM's weekly review, and the money as one more live block
  (defn review-with-money (monday)
    (str (pim-weekly-template monday)
         "\n## Money\n\n"
         (pim-block (str "(money-review \"" monday "\" \"" (date-add monday 6 :days) "\")"))
         "\n")))

;; ⌘⌥V — this week's review, money included
(bind "Mod-Alt-v"
  (ed-new (str "reviews/" (pim-monday *date*) " week.md") (review-with-money (pim-monday *date*))))

;; ══ Zero to Hero — chapter 16. Sharing and backup ══════════════════════════════

(on-load
  (defn row->dict (r fields)
    (reduce (fn (d f) (dict-set d f (field-get r f))) {} fields))

  (defn table-rows (name)
    (records (eval (parse (str "(query " name ")")))))

  (defn table-json (name fields)
    (json-stringify (map (fn (r) (row->dict r fields)) (table-rows name))))

  ;; table name → its fields, for the backup
  (def backup-tables
    (list (list "accounts"     (list :name :kind :currency))
          (list "transactions" (list :day :account :amount :category :note))
          (list "holdings"     (list :symbol :kind :qty :cost))
          (list "prices"       (list :symbol :kind :price :currency :at :source))
          (list "alerts"       (list :symbol :direction :level :fired))))

  ;; one ed-write per table, one for the agenda's own export, then a message
  (defn backup-all ()
    (let (dir (str "backup/" *date*))
      (do (export-agenda "eeditor" :format :json :path (str (current-dir) "/.eeditor/agenda-export.json"))
          (append (map (fn (t) (ed-write (str dir "/" (first t) ".json") (table-json (first t) (second t))))
                       backup-tables)
                  (list (ed-write (str dir "/agenda.json") (read-note ".eeditor/agenda-export.json"))
                        (ed-message (str "Backed up " (length backup-tables) " tables and the agenda to " dir))))))))

;; ⌘⇧0 — everything as JSON, in backup/<today>/
(bind "Mod-Shift-0" (backup-all))
